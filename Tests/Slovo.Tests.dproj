        <DCCReference Include="Infra.LoggerAndSettings.Tests.pas"/>
        <DCCReference Include="Presentation.MainViewModel.Tests.pas"/>
        <DCCReference Include="Presentation.ChapterRtf.Tests.pas"/>
        <BuildConfiguration Include="Base">
