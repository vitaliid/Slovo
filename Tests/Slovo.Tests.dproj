        <DCCReference Include="..\Infrastructure\Infra.Settings.IniSettings.pas"/>
        <DCCReference Include="..\Presentation\Presentation.MainViewModel.pas"/>
        <DCCReference Include="..\Presentation\Presentation.Theme.pas"/>
        <DCCReference Include="..\Presentation\Presentation.ChapterRtf.pas"/>
        <DCCReference Include="Slovo.TestSupport.pas"/>
        <DCCReference Include="Core.Domain.Tests.pas"/>
        <DCCReference Include="Core.Catalog.Tests.pas"/>
        <DCCReference Include="Core.Boundary.Tests.pas"/>
        <DCCReference Include="Infra.LibraryDatabase.Tests.pas"/>
